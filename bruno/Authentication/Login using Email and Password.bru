meta {
  name: Login using Email and Password
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test@email.com",
    "password": "ui1234"
  }
}

script:post-response {
  const cookie = bru.getVar("cookie");
  
  if (cookie) {
    req.setHeader("cookie", cookie)
  }
}

settings {
  encodeUrl: true
}
